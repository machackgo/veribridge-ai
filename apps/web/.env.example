# VeriBridge AI — web app environment template
# Copy to .env.local and fill in. Do NOT commit real secrets.
# Only NEXT_PUBLIC_* values are exposed to the browser — never put the
# Supabase service-role key (or any server secret) in this file.

# ── Public URLs ──────────────────────────────────────────────
# Canonical API origin. Preferred var: NEXT_PUBLIC_API_URL.
#   Local dev:   http://localhost:8000
#   Production:  https://api.veribridgeai.com
NEXT_PUBLIC_API_URL="http://localhost:8000"
# Legacy fallback, still honored if NEXT_PUBLIC_API_URL is unset.
NEXT_PUBLIC_API_BASE_URL="http://localhost:8000"

# Public web app origin (used for absolute/shareable links).
#   Local dev:   http://localhost:3000
#   Production:  https://veribridgeai.com
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="VeriBridge AI"

# ── Supabase (browser-safe values only) ──────────────────────
# Both are public by design (anon key is protected by RLS).
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key-here"
# NOTE: never add SUPABASE_SERVICE_ROLE_KEY here — it bypasses RLS and must
# stay server-side (backend only).
