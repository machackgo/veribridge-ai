# VeriBridge AI — web app environment template
# Copy to .env.local and fill in. Do NOT commit real secrets.
# Only NEXT_PUBLIC_* values are exposed to the browser — never put the
# Supabase service-role key (or any server secret) in this file.

# ── Public URLs ──────────────────────────────────────────────
# Canonical API origin. Preferred var: NEXT_PUBLIC_API_URL.
#   Local dev:   http://localhost:8000
#   Production:  https://api.veribridgeai.com
NEXT_PUBLIC_API_URL="http://localhost:8000"
# Legacy fallback, still honored if NEXT_PUBLIC_API_URL is unset.
NEXT_PUBLIC_API_BASE_URL="http://localhost:8000"

# Public web app origin (used for absolute/shareable links).
#   Local dev:   http://localhost:3000
#   Production:  https://veribridgeai.com
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="VeriBridge AI"

# OPTIONAL override for the Chrome Web Store listing of the Website Proof
# Recorder extension. The published listing URL is built into the app
# (src/lib/recorder-extension-store.ts) so an unset var can never regress the
# live install button — leave this EMPTY in normal deployments. Set it only to
# point a staging build at a different listing; non-Chrome-Web-Store values are
# ignored.
#   Canonical: https://chromewebstore.google.com/detail/veribridge-website-proof/gdogdgnaioldjldljniffcmkcdpdjlme
NEXT_PUBLIC_RECORDER_EXTENSION_STORE_URL=""

# ── Supabase (browser-safe values only) ──────────────────────
# Both are public by design (anon key is protected by RLS).
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key-here"
# NOTE: never add SUPABASE_SERVICE_ROLE_KEY here — it bypasses RLS and must
# stay server-side (backend only).
# Length of the emailed email-verification (OTP) code. MUST match the Supabase
# project's Authentication → Email → "Email OTP Length" setting (6–10). Our
# project sends 8-digit codes; the login input sizes itself to this value.
NEXT_PUBLIC_OTP_CODE_LENGTH="8"
