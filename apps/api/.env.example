# ── App identity ─────────────────────────────────────────────
APP_NAME=careerproof-api
APP_VERSION=0.1.0
API_V1_PREFIX=/api/v1
ENVIRONMENT=development

# ── CORS ─────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins.
# Canonical var is CORS_ALLOWED_ORIGINS (CORS_ORIGINS still accepted for
# backward compatibility). A literal "*" is rejected when ENVIRONMENT=production.
#
# Local dev (default):
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Production (veribridgeai.com) — set this on Render instead of the line above:
#   CORS_ALLOWED_ORIGINS=https://veribridgeai.com,https://www.veribridgeai.com,http://localhost:3000,http://127.0.0.1:3000

# ── Public URLs (production domain integration) ──────────────
# Absolute public origins. Local dev defaults shown; in production set:
#   FRONTEND_URL=https://veribridgeai.com
#   PUBLIC_APP_URL=https://veribridgeai.com
#   BACKEND_PUBLIC_URL=https://api.veribridgeai.com
FRONTEND_URL=http://localhost:3000
PUBLIC_APP_URL=http://localhost:3000
BACKEND_PUBLIC_URL=http://localhost:8000

# ── Supabase ─────────────────────────────────────────────────
# Find these in: Supabase dashboard → Project Settings → API

# Project REST/API base URL (not a secret, but env-driven).
SUPABASE_URL=https://your-project-ref.supabase.co

# Public anon key — safe for browser clients.
SUPABASE_ANON_KEY=your-anon-key-here

# Service-role key — bypasses RLS. SERVER SIDE ONLY.
# Never expose this to frontend code or commit it to version control.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ── VBR session recording storage ─────────────────────────────
# Name of the private Supabase Storage bucket for Verified Build Report
# (VBR) / Project Defense session video chunks.
# Create it once: Supabase dashboard → Storage → New bucket → "Private bucket".
# Leave empty to disable recording (chunk-upload-url returns 503).
SUPABASE_VBR_MEDIA_BUCKET=vbr-media

# ── Auth ─────────────────────────────────────────────────────
# Token verification supports both Supabase signing schemes:
#   • Asymmetric "JWT signing keys" (ES256/RS256) — the default on current
#     Supabase projects. Verified automatically against the public JWKS at
#     {SUPABASE_URL}/auth/v1/.well-known/jwks.json. Nothing to configure
#     beyond SUPABASE_URL; leave SUPABASE_JWT_SECRET unset.
#   • Legacy HS256 JWT Secret — only needed if your project still signs
#     tokens with the shared secret. Find it at: Supabase dashboard →
#     Settings → API → JWT Settings → JWT Secret.
# A token that can't be verified by either scheme always fails closed (401);
# it never resolves to the demo user. See ENABLE_DEMO_USER_FALLBACK.
SUPABASE_JWT_SECRET=

# ── Demo / development ───────────────────────────────────────
# SECURITY: DEMO_USER_ID is a real, data-bearing account. The no-token fallback
# to it is OFF by default and gated behind ENABLE_DEMO_USER_FALLBACK so an
# unauthenticated request can never read/write another user's private proofs.
# It applies ONLY when: ENVIRONMENT != "production" AND
# ENABLE_DEMO_USER_FALLBACK=true AND the request has no Authorization header.
# A present-but-invalid/expired token always → 401, never the demo user.
# Leave this false unless you are doing throwaway local curl/Swagger poking,
# and prefer pointing DEMO_USER_ID at a disposable account when you do.
ENABLE_DEMO_USER_FALLBACK=false

# Fallback user ID used only when the fallback above is explicitly enabled.
# Set to the UUID printed by scripts/create_demo_auth_user.py after you run it.
# Default (when unset): 00000000-0000-0000-0000-000000000001
DEMO_USER_ID=00000000-0000-0000-0000-000000000001

# ── Database (direct Postgres connection) ─────────────────────
# Used by async SQLAlchemy if direct DB access is needed.
# Use the "Session mode" pooler URL from:
#   Supabase → Settings → Database → Connection string
DATABASE_URL=postgresql+asyncpg://postgres:your-password@db.your-project-ref.supabase.co:5432/postgres

# ── GitHub API ────────────────────────────────────────────────
# Optional GitHub personal access token for portfolio scanning.
# Without a token, GitHub enforces a limit of 60 unauthenticated
# requests/hour per IP, which can cause rate-limit errors on large scans.
# With a token (classic PAT or fine-grained), the limit rises to 5,000/hour.
#
# To create one: GitHub → Settings → Developer settings → Personal access tokens
# Required scopes: public_repo (read access to public repositories is enough).
#
# NEVER commit a real token to version control.
GITHUB_TOKEN=

# ── Visual Frame Capture (Website Proof) ─────────────────────
# Set to false to disable screenshot capture during extension recordings.
# When false, the endpoint accepts requests but stores nothing and returns
# frame_capture_enabled=false. DOM evidence continues to work regardless.
# Default: true (table workflow_visual_frame_evidence must exist — run migrations).
ENABLE_WORKFLOW_FRAME_CAPTURE=true

# Maximum screenshot frames accepted per proof session (default 15).
MAX_WORKFLOW_FRAMES=15

# Visual analysis provider: none | local_ocr | local_vision
# none     — frames are stored but not analyzed (default, no extra dependencies)
# local_ocr — run OCR via paddleocr / easyocr / tesseract (set LOCAL_OCR_PROVIDER)
# local_vision — run vision model locally (set LOCAL_VISION_PROVIDER)
VISUAL_ANALYSIS_PROVIDER=none

# ── LLM Proof Synthesis (Step 4) ─────────────────────────────
# Provider-agnostic, recruiter-readable synthesis of already-linked proof chains.
# Anthropic is NEVER required: the default is fully disabled and a deterministic,
# rule-based fallback is always used when the LLM is off/unavailable/invalid.
# Recommended: a LOCAL OpenAI-compatible endpoint (Ollama / vLLM / LM Studio
# serving Qwen) so synthesis costs nothing per call.
#
# Master switch — when false the deterministic fallback is used for every chain.
LLM_SYNTHESIS_ENABLED=false
# Provider: disabled | local_openai | anthropic
#   disabled     — deterministic fallback only (default; no network)
#   local_openai — POST {LOCAL_LLM_BASE_URL}/chat/completions (OpenAI shape)
#   anthropic    — only used when ANTHROPIC_API_KEY + AI_REVIEWER_MODEL are set too
LLM_SYNTHESIS_PROVIDER=disabled
# Local OpenAI-compatible endpoint (Ollama default; works with vLLM / LM Studio).
LOCAL_LLM_BASE_URL=http://localhost:11434/v1
LOCAL_LLM_MODEL=qwen3:14b
LOCAL_LLM_API_KEY=ollama
# Per-call timeout (seconds); a slow/hung provider falls the chain back.
LLM_SYNTHESIS_TIMEOUT_SECONDS=30
# Bounded parallel synthesis. Default 1 (single local model); raise to 2 locally
# only after testing, or 4/8+ on a GPU/vLLM server.
LLM_SYNTHESIS_MAX_CONCURRENCY=1
# Max chains that may use the LLM per report run (cost guard); the rest stay
# deterministic.
LLM_SYNTHESIS_MAX_CHAINS_PER_RUN=20

# ── Speech-to-text (Project Defense video transcription) ────────────────────
# Provider: none | openai | local_whisper
#   none          — disabled; students paste their transcript manually (default)
#   openai        — OpenAI Whisper API (requires OPENAI_API_KEY)
#   local_whisper — faster-whisper running locally (pip install faster-whisper)
TRANSCRIPTION_PROVIDER=none
# local_whisper model + device. large-v3-turbo is the recommended default for
# English on a MacBook M-series (best accuracy/speed, fixes weak-model
# hallucination). On a GPU-less server use `small`. faster-whisper has no
# Metal/MPS backend, so Apple Silicon must use device=cpu.
LOCAL_WHISPER_MODEL_SIZE=large-v3-turbo
LOCAL_WHISPER_DEVICE=cpu          # cpu | cuda | auto
LOCAL_WHISPER_COMPUTE_TYPE=int8   # int8 | float16 | float32
LOCAL_WHISPER_LANGUAGE=en         # "" → auto-detect
# Anti-hallucination decoding tuning (defaults suppress "new new new …" loops).
LOCAL_WHISPER_BEAM_SIZE=5
LOCAL_WHISPER_VAD=true
LOCAL_WHISPER_CONDITION_ON_PREVIOUS_TEXT=false
LOCAL_WHISPER_TEMPERATURE=0.0
LOCAL_WHISPER_NO_SPEECH_THRESHOLD=0.6
LOCAL_WHISPER_COMPRESSION_RATIO_THRESHOLD=2.4
LOCAL_WHISPER_LOG_PROB_THRESHOLD=-1.0
