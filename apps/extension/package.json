{
  "name": "veribridge-extension",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "esbuild src/background.ts src/popup.ts src/content.ts src/recorder.ts --bundle --outdir=dist --target=chrome112 --platform=browser --define:__VB_DEV_BUILD__=true",
    "build:release": "esbuild src/background.ts src/popup.ts src/content.ts src/recorder.ts --bundle --outdir=dist --target=chrome112 --platform=browser --define:__VB_DEV_BUILD__=false",
    "dev": "esbuild src/background.ts src/popup.ts src/content.ts src/recorder.ts --bundle --outdir=dist --target=chrome112 --platform=browser --watch --define:__VB_DEV_BUILD__=true",
    "package:release": "node scripts/package-release.mjs",
    "test": "node scripts/run-tests.mjs",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.260",
    "esbuild": "^0.24.0",
    "typescript": "^5.4.0"
  }
}
