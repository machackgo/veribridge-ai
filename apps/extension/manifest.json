{
  "manifest_version": 3,
  "name": "VeriBridge",
  "version": "0.2.0",
  "version_name": "0.2.0 (recorder schema 1)",
  "description": "Record project workflow evidence for skill verification.",
  "permissions": ["activeTab", "scripting", "storage", "tabs"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "dist/background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "VeriBridge"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["dist/content.js"],
      "run_at": "document_idle"
    }
  ]
}
