# CareerProof AI environment template
# Copy values into app-specific local env files when frontend and backend are scaffolded.
# Do not commit real secrets.

# Frontend
NEXT_PUBLIC_APP_NAME="CareerProof AI"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_API_BASE_URL="http://localhost:8000"

# Backend
API_ENV="development"
API_HOST="0.0.0.0"
API_PORT="8000"
API_CORS_ORIGINS="http://localhost:3000"

# Supabase
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"
SUPABASE_DB_URL="postgresql://user:password@host:5432/postgres"

# AI Providers
OPENAI_API_KEY="your-openai-api-key"
ANTHROPIC_API_KEY="your-anthropic-api-key"

# Auth and Security
JWT_SECRET="replace-with-local-development-secret"
ENCRYPTION_KEY="replace-with-local-development-key"
