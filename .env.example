# VeriBridge AI environment template
# Copy values into app-specific local env files when frontend and backend are scaffolded.
# Do not commit real secrets.

# Frontend
NEXT_PUBLIC_APP_NAME="VeriBridge AI"
# Public web app origin. Production: https://veribridgeai.com
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Canonical API origin. Production: https://api.veribridgeai.com
# NEXT_PUBLIC_API_URL is preferred; NEXT_PUBLIC_API_BASE_URL is the legacy
# fallback and is kept working for backward compatibility.
NEXT_PUBLIC_API_URL="http://localhost:8000"
NEXT_PUBLIC_API_BASE_URL="http://localhost:8000"

# Backend
API_ENV="development"
API_HOST="0.0.0.0"
API_PORT="8000"
# Canonical var is CORS_ALLOWED_ORIGINS (CORS_ORIGINS also accepted).
# Production: https://veribridgeai.com,https://www.veribridgeai.com,http://localhost:3000,http://127.0.0.1:3000
CORS_ALLOWED_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"
# Public URLs (production domain integration).
# Production: FRONTEND_URL / PUBLIC_APP_URL = https://veribridgeai.com,
#             BACKEND_PUBLIC_URL = https://api.veribridgeai.com
FRONTEND_URL="http://localhost:3000"
PUBLIC_APP_URL="http://localhost:3000"
BACKEND_PUBLIC_URL="http://localhost:8000"

# Supabase
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"
SUPABASE_DB_URL="postgresql://user:password@host:5432/postgres"

# AI Providers
OPENAI_API_KEY="your-openai-api-key"
ANTHROPIC_API_KEY="your-anthropic-api-key"

# Auth and Security
JWT_SECRET="replace-with-local-development-secret"
ENCRYPTION_KEY="replace-with-local-development-key"
